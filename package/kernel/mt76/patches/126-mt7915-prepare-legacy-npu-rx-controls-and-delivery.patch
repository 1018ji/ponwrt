 	u16 tid = params->tid;
 	u16 ssn = params->ssn;
 	struct mt76_txq *mtxq;
-	int ret = 0;
+	int ret = 0, npu_err;
 
 	if (!txq)
 		return -EINVAL;
@@ -984,13 +996,25 @@
 	mutex_lock(&dev->mt76.mutex);
 	switch (action) {
 	case IEEE80211_AMPDU_RX_START:
-		mt76_rx_aggr_start(&dev->mt76, &msta->wcid, tid, ssn,
-				   params->buf_size);
-		ret = mt7915_mcu_add_rx_ba(dev, params, true);
+		ret = mt7915_npu_legacy_ba(dev, &msta->wcid, tid,
+					 params->buf_size, ssn);
+		if (ret)
+			break;
+		ret = mt76_rx_aggr_start(&dev->mt76, &msta->wcid, tid, ssn,
+					params->buf_size);
+		if (!ret)
+			ret = mt7915_mcu_add_rx_ba(dev, params, true);
+		if (ret) {
+			mt76_rx_aggr_stop(&dev->mt76, &msta->wcid, tid);
+			mt7915_npu_legacy_ba(dev, &msta->wcid, tid, 0, 0);
+		}
 		break;
 	case IEEE80211_AMPDU_RX_STOP:
 		mt76_rx_aggr_stop(&dev->mt76, &msta->wcid, tid);
 		ret = mt7915_mcu_add_rx_ba(dev, params, false);
+		npu_err = mt7915_npu_legacy_ba(dev, &msta->wcid, tid, 0, 0);
+		if (!ret)
+			ret = npu_err;
 		break;
 	case IEEE80211_AMPDU_TX_OPERATIONAL:
 		mtxq->aggr = true;
