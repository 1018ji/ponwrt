 }
 
+static bool mt7915_npu_legacy_rx_valid(struct sk_buff *skb)
+{
+	__le32 *rxd = (__le32 *)skb->data;
+	unsigned int len = skb_headlen(skb), offset = 6 * sizeof(*rxd);
+	u32 rxd1, rxd2;
+	__le16 fc;
+
+	if (len < offset || le32_get_bits(rxd[0], MT_RXD0_PKT_TYPE) != PKT_TYPE_NORMAL)
+		return false;
+	rxd1 = le32_to_cpu(rxd[1]);
+	rxd2 = le32_to_cpu(rxd[2]);
+	if (rxd1 & MT_RXD1_NORMAL_GROUP_4)
+		offset += 16;
+	if (rxd1 & MT_RXD1_NORMAL_GROUP_1)
+		offset += 16;
+	if (rxd1 & MT_RXD1_NORMAL_GROUP_2)
+		offset += 8;
+	if (rxd1 & MT_RXD1_NORMAL_GROUP_3) {
+		offset += 8;
+		if (rxd1 & MT_RXD1_NORMAL_GROUP_5)
+			offset += 72;
+	} else if (rxd1 & MT_RXD1_NORMAL_GROUP_5) {
+		return false;
+	}
+	offset += 2 * FIELD_GET(MT_RXD2_NORMAL_HDR_OFFSET, rxd2);
+	if (offset > len)
+		return false;
+	len -= offset;
+	if (rxd2 & MT_RXD2_NORMAL_HDR_TRANS) {
+		if (len < ETH_HLEN)
+			return false;
+		if ((rxd2 & MT_RXD2_NORMAL_HDR_TRANS_ERROR) &&
+		    get_unaligned_be16(skb->data + offset + 12) == ETH_P_8021Q)
+			return len >= ETH_HLEN + 6;
+		return true;
+	}
+	if (len < sizeof(fc))
+		return false;
+	memcpy(&fc, skb->data + offset, sizeof(fc));
+	if (len < ieee80211_hdrlen(fc))
+		return false;
+	if (ieee80211_is_back_req(fc) && len < sizeof(struct ieee80211_bar))
+		return false;
+	if (FIELD_GET(MT_RXD4_NORMAL_PAYLOAD_FORMAT, le32_to_cpu(rxd[4])) &&
+	    len < ieee80211_hdrlen(fc) + 2)
+		return false;
+
+	return true;
+}
+
 void mt7915_queue_rx_skb(struct mt76_dev *mdev, enum mt76_rxq_id q,
 			 struct sk_buff *skb, u32 *info)
 {
@@ -1056,6 +1120,16 @@
 	__le32 *end = (__le32 *)&skb->data[skb->len];
 	enum rx_pkt_type type;
 
+	if (mt76_queue_is_npu_legacy(&mdev->q_rx[q])) {
+		/* Keep the host NAPI qid so mt76 flushes the same software queue. */
+		if (READ_ONCE(dev->npu_legacy_failed) || !mt7915_npu_legacy_rx_valid(skb)) {
+			dev_kfree_skb(skb);
+			return;
+		}
+		/* Native checksum status is not verified for the legacy vendor word. */
+		*(u32 *)skb->cb = BIT(0) | BIT(2) | BIT(3);
+	}
+
 	type = le32_get_bits(rxd[0], MT_RXD0_PKT_TYPE);
 
 	switch (type) {
@@ -1084,6 +1158,8 @@
 		break;
 	case PKT_TYPE_NORMAL:
 		if (!mt7915_mac_fill_rx(dev, skb, q, info)) {
+			if (mt76_queue_is_npu_legacy(&mdev->q_rx[q]))
+				((struct mt76_rx_status *)skb->cb)->flag |= RX_FLAG_DUP_VALIDATED;
 			mt76_rx(&dev->mt76, q, skb);
 			return;
 		}
