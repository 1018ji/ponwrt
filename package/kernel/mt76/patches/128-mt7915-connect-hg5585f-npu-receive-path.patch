--- a/mt7915/npu_legacy.c
+++ b/mt7915/npu_legacy.c
@@ -1,8 +1,12 @@
 // SPDX-License-Identifier: GPL-2.0-only
 /* HG5585F MT7916 receive-side state synchronization. */
 #include <linux/soc/airoha/airoha_wlan_legacy.h>
+#include <linux/of.h>
 
 #include "mt7915.h"
+#include "../dma.h"
+
+static_assert(MT7915_NPU_RX_RING_SIZE == AIROHA_WLAN_LEGACY_INPUT_COUNT);
 
 static bool mt7915_npu_is_legacy(struct airoha_npu *npu)
 {
@@ -35,6 +39,8 @@
 	/* Descriptor/page ownership stays with the queues until DMA is quiesced. */
 	dev_err_ratelimited(dev->mt76.dev, "legacy NPU state synchronization failed: %d\n",
 			    error);
+	if (dev->recovery.hw_init_done)
+		queue_work(dev->mt76.wq, &dev->reset_work);
 }
 
 static int mt7915_npu_legacy_send(struct mt7915_dev *dev, unsigned int band,
@@ -142,3 +148,195 @@
 	/* NPU queue IDs must never index the chip's native interrupt map. */
 	return true;
 }
+
+int mt7915_npu_legacy_init(struct mt7915_dev *dev)
+{
+	struct pci_dev *pdev;
+
+	if (!of_property_present(dev->mt76.dev->of_node, "airoha,hg5585f-rx-offload"))
+		return 0;
+	if (!is_mt7916(&dev->mt76) || !dev_is_pci(dev->mt76.dev) ||
+	    of_property_present(dev->mt76.dev->of_node, "airoha,wed"))
+		return -EOPNOTSUPP;
+	pdev = to_pci_dev(dev->mt76.dev);
+	return mt76_npu_legacy_init(&dev->mt76, pci_resource_start(pdev, 0));
+}
+
+int mt7915_npu_legacy_quiesce(struct mt7915_dev *dev)
+{
+	struct mt76_dev *mdev = &dev->mt76;
+	struct airoha_npu *npu;
+	u32 offset = dev->hif2 ? MT_WFDMA0_PCIE1(0) - MT_WFDMA0(0) : 0;
+	u32 busy = BIT(1) | BIT(3);
+	int q, err = 0, stop_err;
+
+	if (!mdev->mmio.npu_legacy_rx)
+		return 0;
+	if (mdev->mmio.npu_quarantined)
+		return -EIO;
+	mt7915_irq_disable(dev, ~0);
+	for (q = MT_RXQ_NPU0; q <= MT_RXQ_NPU1; q++)
+		WRITE_ONCE(mdev->q_rx[q].stopped, true);
+	mt76_npu_disable_irqs(mdev);
+	mt76_clear(dev, MT_WFDMA0_GLO_CFG,
+		   MT_WFDMA0_GLO_CFG_TX_DMA_EN | MT_WFDMA0_GLO_CFG_RX_DMA_EN);
+	if (dev->hif2)
+		mt76_clear(dev, MT_WFDMA0_GLO_CFG + offset,
+			   MT_WFDMA0_GLO_CFG_TX_DMA_EN | MT_WFDMA0_GLO_CFG_RX_DMA_EN);
+	if (!mt76_poll_msec(dev, MT_WFDMA0_GLO_CFG, busy, 0, 100))
+		err = -ETIMEDOUT;
+	if (dev->hif2 &&
+	    !mt76_poll_msec(dev, MT_WFDMA0_GLO_CFG + offset, busy, 0, 100))
+		err = -ETIMEDOUT;
+	pci_clear_master(to_pci_dev(mdev->dev));
+	if (dev->hif2)
+		pci_clear_master(to_pci_dev(dev->hif2->dev));
+	npu = rcu_dereference_protected(mdev->mmio.npu, 1);
+	stop_err = npu ? airoha_npu_wlan_legacy_quiesce(npu, mdev->dev) : -ENODEV;
+	if (!err)
+		err = stop_err;
+	if (err) {
+		if (npu)
+			airoha_npu_wlan_legacy_poison(npu, mdev->dev);
+		WRITE_ONCE(dev->npu_legacy_failed, true);
+		mdev->mmio.npu_quarantined = true;
+		dev_err(mdev->dev, "legacy NPU DMA stop failed: %d; memory retained\n", err);
+	}
+	dev->npu_legacy_configured = false;
+	return err;
+}
+
+static int mt7915_npu_legacy_port_type(struct mt7915_dev *dev)
+{
+	int primary = pci_domain_nr(to_pci_dev(dev->mt76.dev)->bus);
+
+	if (primary > 1)
+		return -EOPNOTSUPP;
+	if (dev->hif2) {
+		int secondary = pci_domain_nr(to_pci_dev(dev->hif2->dev)->bus);
+
+		if (secondary > 1 || secondary == primary)
+			return -EOPNOTSUPP;
+		/* Stock 2 maps band0/band1 to PCIe0/1; 3 reverses that mapping. */
+		return primary ? 3 : 2;
+	}
+	return primary;
+}
+
+int mt7915_npu_legacy_rx_setup(struct mt7915_dev *dev, bool initial)
+{
+	struct mt76_dev *mdev = &dev->mt76;
+	struct airoha_npu *npu;
+	int band, type, err;
+
+	if (!mdev->mmio.npu_legacy_rx)
+		return 0;
+	if (mdev->mmio.npu_quarantined)
+		return -EIO;
+	npu = rcu_dereference_protected(mdev->mmio.npu, 1);
+	if (!npu)
+		return -ENODEV;
+	if (!initial) {
+		err = airoha_npu_wlan_legacy_acquire(npu, mdev->dev);
+		if (err)
+			return err;
+		err = airoha_npu_wlan_init_reserved_memory(npu);
+		if (err)
+			return err;
+	}
+	WRITE_ONCE(dev->npu_legacy_failed, false);
+	type = mt7915_npu_legacy_port_type(dev);
+	if (type < 0)
+		return type;
+	err = mt7915_npu_legacy_send(dev, 0, WLAN_FUNC_SET_WAIT_DRIVER_MODEL, 2);
+	if (err)
+		return err;
+	err = mt7915_npu_legacy_send(dev, 0, WLAN_FUNC_SET_WAIT_PCIE_PORT_TYPE, type);
+	if (err)
+		return err;
+	/* This receive mode reorders in NPU and returns every frame to Linux. */
+	err = mt7915_npu_legacy_send(dev, 0, WLAN_FUNC_SET_WAIT_IS_FORCE_TO_CPU, 1);
+	if (err)
+		return err;
+	err = mt7915_npu_legacy_send(dev, 1, WLAN_FUNC_SET_WAIT_NPU_BAND0_ONCPU, 0);
+	if (err)
+		return err;
+	for (band = 0; band < 2; band++) {
+		struct mt76_queue *input = &mdev->q_rx[band ? MT_RXQ_BAND1 : MT_RXQ_MAIN];
+		struct mt76_queue *host = &mdev->q_rx[MT_RXQ_NPU0 + band];
+		u32 base;
+		u64 offset, address;
+
+		if (!(input->flags & MT_QFLAG_NPU_INPUT))
+			continue;
+		offset = (u8 __iomem *)input->regs - (u8 __iomem *)mdev->mmio.regs;
+		address = mdev->mmio.phy_addr + offset;
+		if (upper_32_bits(address) ||
+		    offset + sizeof(*input->regs) >
+		    pci_resource_len(to_pci_dev(mdev->dev), 0))
+			return -ERANGE;
+		err = mt7915_npu_legacy_send(dev, band, WLAN_FUNC_SET_WAIT_PCIE_ADDR, address);
+		if (err)
+			return err;
+		err = mt7915_npu_legacy_send(dev, band, WLAN_FUNC_SET_WAIT_DESC,
+					     AIROHA_WLAN_LEGACY_INPUT_COUNT);
+		if (err)
+			return err;
+		err = mt76_npu_get_msg(npu, band, WLAN_FUNC_GET_WAIT_RXDESC_BASE,
+				       &base, GFP_KERNEL);
+		if (err)
+			return err;
+		if ((base & 15) || base < 0x1e800000 ||
+		    base > 0x1e878000 - AIROHA_WLAN_LEGACY_INPUT_COUNT * 16)
+			return -ERANGE;
+		if (initial) {
+			err = mt76_npu_rx_queue_init(mdev, host);
+		} else {
+			host->stopped = false;
+			mt76_npu_legacy_rx_fill(mdev, host);
+			err = mt76_npu_legacy_rx_publish(host);
+		}
+		if (err)
+			return err;
+		writel(base, &input->regs->desc_base);
+		writel(AIROHA_WLAN_LEGACY_INPUT_COUNT, &input->regs->ring_size);
+		writel(AIROHA_WLAN_LEGACY_INPUT_COUNT - 1, &input->regs->cpu_idx);
+		writel(0, &input->regs->dma_idx);
+	}
+	dev->npu_legacy_configured = true;
+	/* Recovery callers schedule each host NAPI after enabling it again. */
+	if (initial) {
+		for (band = 0; band < 2; band++)
+			if (mdev->q_rx[MT_RXQ_NPU0 + band].ndesc)
+				airoha_npu_wlan_enable_irq(npu, band);
+	}
+	return 0;
+}
