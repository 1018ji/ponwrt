+#ifdef CONFIG_MT76_NPU_LEGACY
+int mt76_npu_legacy_init(struct mt76_dev *dev, phys_addr_t address)
+{
+	struct airoha_npu *npu;
+	int err;
+
+	npu = airoha_npu_get(dev->dev);
+	if (IS_ERR(npu)) {
+		request_module("airoha-npu");
+		npu = airoha_npu_get(dev->dev);
+	}
+	if (IS_ERR(npu))
+		return PTR_ERR(npu);
+	if (!npu)
+		return -EOPNOTSUPP;
+	if (npu->wlan_abi != AIROHA_NPU_WLAN_ABI_HG5585F_2024 ||
+	    upper_32_bits(address)) {
+		err = -EOPNOTSUPP;
+		goto put;
+	}
+	err = airoha_npu_wlan_legacy_acquire(npu, dev->dev);
+	if (err)
+		goto put;
+	err = airoha_npu_wlan_init_reserved_memory(npu);
+	if (err) {
+		/* A failed stop retains the supplier and every DMA mapping. */
+		if (airoha_npu_wlan_legacy_release(npu, dev->dev))
+			return err;
+		goto put;
+	}
+	dev->dma_dev = npu->dev;
+	dev->mmio.phy_addr = address;
+	dev->mmio.npu_legacy_rx = true;
+	rcu_assign_pointer(dev->mmio.npu, npu);
+	return 0;
+put:
+	airoha_npu_put(npu);
+	return err;
+}
+EXPORT_SYMBOL_GPL(mt76_npu_legacy_init);
+
+void mt76_npu_legacy_free_irq(struct mt76_dev *dev, struct mt76_queue *q)
+{
+	struct airoha_npu *npu;
+	int index = q - dev->q_rx - MT_RXQ_NPU0;
+
+	if (!mt76_queue_is_npu_legacy(q))
+		return;
+	npu = rcu_dereference_protected(dev->mmio.npu, 1);
+	if (npu && index >= 0 && index < 2)
+		devm_free_irq(dev->dev, npu->irqs[index], q);
+}
+EXPORT_SYMBOL_GPL(mt76_npu_legacy_free_irq);
