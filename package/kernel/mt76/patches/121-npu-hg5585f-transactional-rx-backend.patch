+					 struct mt76_queue *q, u32 *info);
+void mt76_npu_legacy_rx_cleanup(struct mt76_dev *dev, struct mt76_queue *q);
+#else
+static inline int mt76_npu_legacy_rx_fill(struct mt76_dev *dev, struct mt76_queue *q)
+{
+	return 0;
+}
+
+static inline struct sk_buff *
