From: PonWrt developers <noreply@localhost>
Subject: [PATCH] wifi: mt76: retire both HG5585F DMA owners before PCI unwind

Keep WED attached while the NPU and wireless queues are quiesced on failed
probe. Track completed DMA initialization for both offload modes and free
only IRQ vectors allocated by this probe. Disable legacy recovery before
failed registration retires NAPI, and stop the IRQ tasklet before freeing
DMA queues. A late WED cleanup failure also poisons and pins the NPU.

---
--- a/dma.c
+++ b/dma.c
@@ -1220,6 +1220,16 @@
 	int i;
 
 	quarantine |= dev->mmio.npu_quarantined;
+#ifdef CONFIG_MT76_NPU_LEGACY
+	if (quarantine && dev->mmio.npu_legacy_rx) {
+		struct airoha_npu *npu;
+
+		dev->mmio.npu_quarantined = true;
+		npu = rcu_dereference_protected(dev->mmio.npu, 1);
+		if (npu)
+			airoha_npu_wlan_legacy_poison(npu, dev->dev);
+	}
+#endif
 
 	mt76_worker_disable(&dev->tx_worker);
 	napi_disable(&dev->tx_napi);
--- a/mt7915/dma.c
+++ b/mt7915/dma.c
@@ -676,8 +676,8 @@
 	netif_napi_add_tx(dev->mt76.tx_napi_dev, &dev->mt76.tx_napi,
 			  mt7915_poll_tx);
 	napi_enable(&dev->mt76.tx_napi);
+	dev->dma_initialized = true;
 	if (mdev->mmio.npu_legacy_rx) {
-		dev->npu_legacy_dma_ready = true;
 		ret = mt7915_npu_legacy_rx_setup(dev, true);
 		if (ret)
 			return ret;
@@ -761,5 +761,41 @@
 	mt7915_dma_disable(dev, true);
 
 	mt76_dma_cleanup(&dev->mt76);
-	dev->npu_legacy_dma_ready = false;
-}
+	dev->dma_initialized = false;
+}
+
+void mt7915_offload_cleanup(struct mt7915_dev *dev)
+{
+	bool offload = dev->mt76.mmio.npu_legacy_rx;
+	int q;
+
+#ifdef CONFIG_NET_AIROHA_WED
+	offload |= mtk_wed_device_active(&dev->mt76.mmio.wed) &&
+		   dev->mt76.mmio.wed.airoha;
+#endif
+	if (!offload)
+		return;
+	if (dev->dma_initialized || READ_ONCE(dev->recovery.hw_init_done)) {
+		WRITE_ONCE(dev->recovery.hw_init_done, false);
+		synchronize_rcu();
+		cancel_work_sync(&dev->dump_work);
+		cancel_work_sync(&dev->reset_work);
+	}
+	mt7915_pci_irq_cleanup(dev);
+	if (!dev->dma_initialized) {
+		if (!mt7915_dma_quiesce(dev)) {
+			/* Probe failed before NAPI could fill these native queues. */
+			mt76_for_each_q_rx(&dev->mt76, q) {
+				if (dev->mt76.q_rx[q].page_pool) {
+					page_pool_destroy(dev->mt76.q_rx[q].page_pool);
+					dev->mt76.q_rx[q].page_pool = NULL;
+				}
+			}
+		}
+		return;
+	}
+	mt76_for_each_q_rx(&dev->mt76, q)
+		if (!mt76_queue_is_wed_rro(&dev->mt76.q_rx[q]))
+			napi_disable(&dev->mt76.napi[q]);
+	mt7915_dma_cleanup(dev);
+}
