 }
 
+void mt7915_pci_irq_cleanup(struct mt7915_dev *dev)
+{
+	int irq = to_pci_dev(dev->mt76.dev)->irq;
+
+	clear_bit(MT76_STATE_INITIALIZED, &dev->mphy.state);
+	mt7915_irq_disable(dev, ~0);
+#ifdef CONFIG_NET_MEDIATEK_SOC_WED
+	if (mtk_wed_device_active(&dev->mt76.mmio.wed))
+		irq = dev->mt76.mmio.wed.irq;
+#endif
+	/* An IRQ may have observed INITIALIZED before it was cleared. */
+	synchronize_irq(irq);
+	if (dev->hif2)
+		synchronize_irq(dev->hif2->irq);
+	tasklet_kill(&dev->mt76.irq_tasklet);
+}
