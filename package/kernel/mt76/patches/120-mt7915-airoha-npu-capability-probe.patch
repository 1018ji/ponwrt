--- /dev/null
+++ b/mt7915/npu_probe.c
@@ -0,0 +1,91 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* MT7916 / Airoha NPU capability snapshot. No DMA rings are redirected. */
+#include <linux/debugfs.h>
+#include <linux/module.h>
+#include <linux/seq_file.h>
+#include <linux/soc/airoha/airoha_wlan_legacy.h>
+
+#include "mt7915.h"
+
+static bool npu_probe;
+module_param(npu_probe, bool, 0444);
+MODULE_PARM_DESC(npu_probe, "Query Airoha NPU capabilities without enabling offload");
+
+void mt7915_npu_probe(struct mt7915_dev *dev)
+{
+	struct mt7915_npu_probe *probe = &dev->npu_probe;
+	struct airoha_npu *npu;
+	u32 value;
+	int i, err;
+
+	if (!npu_probe || !is_mt7916(&dev->mt76))
+		return;
+
+	probe->attempted = true;
+	npu = airoha_npu_get(dev->mt76.dev);
+	if (IS_ERR(npu)) {
+		probe->error = PTR_ERR(npu);
+		dev_info(dev->mt76.dev, "NPU probe unavailable: %d\n", probe->error);
+		return;
+	}
+
+	probe->abi = npu->wlan_abi;
+	if (probe->abi == AIROHA_NPU_WLAN_ABI_UPSTREAM) {
+		err = mt76_npu_get_msg(npu, 0, WLAN_FUNC_GET_WAIT_NPU_VERSION,
+				       &value, GFP_KERNEL);
+		if (err)
+			goto out;
+		probe->version = value;
+		err = mt76_npu_get_msg(npu, 0, WLAN_FUNC_GET_WAIT_NPU_SUPPORT_MAP,
+				       &value, GFP_KERNEL);
+		if (err)
+			goto out;
+		probe->support_map = value;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(probe->rx_base); i++) {
+		err = mt76_npu_get_msg(npu, i, WLAN_FUNC_GET_WAIT_RXDESC_BASE,
+				       &value, GFP_KERNEL);
+		if (err)
+			goto out;
+		probe->rx_base[i] = value;
+	}
+
+out:
+	probe->error = err;
+	airoha_npu_put(npu);
+	dev_info(dev->mt76.dev,
+		 "NPU probe ABI=%u result=%d RX bases=%08x/%08x; offload disabled\n",
+		 probe->abi, probe->error, probe->rx_base[0], probe->rx_base[1]);
+}
+
+static int mt7915_npu_probe_show(struct seq_file *s, void *unused)
+{
+	struct mt7915_dev *dev = s->private;
+	struct mt7915_npu_probe *probe = &dev->npu_probe;
+
+	seq_printf(s, "attempted: %u\n", probe->attempted);
+	seq_printf(s, "error: %d\n", probe->error);
+	seq_printf(s, "abi: %u\n", probe->abi);
+	seq_printf(s, "version: %08x\n", probe->version);
+	seq_printf(s, "support_map: %08x\n", probe->support_map);
+	seq_printf(s, "rx_base_0: %08x\n", probe->rx_base[0]);
+	seq_printf(s, "rx_base_1: %08x\n", probe->rx_base[1]);
+	if (probe->abi == AIROHA_NPU_WLAN_ABI_HG5585F_2024) {
+		seq_printf(s, "legacy_rx_desc_bytes: %u\n",
+			   AIROHA_WLAN_LEGACY_RX_DESC_BYTES);
+		seq_printf(s, "legacy_rx_desc_count: %u\n",
+			   AIROHA_WLAN_LEGACY_RX_DESC_COUNT);
+		seq_printf(s, "legacy_rx_buf_bytes: %u\n",
+			   AIROHA_WLAN_LEGACY_RX_BUF_BYTES);
+	}
+	seq_puts(s, "rx_offload: disabled\ntx_offload: disabled\n");
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(mt7915_npu_probe);
+
+void mt7915_npu_probe_debugfs(struct mt7915_dev *dev, struct dentry *dir)
+{
+	debugfs_create_file("npu_probe", 0400, dir, dev,
+			    &mt7915_npu_probe_fops);
+}
