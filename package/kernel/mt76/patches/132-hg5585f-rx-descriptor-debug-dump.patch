From: PonWrt developers <noreply@localhost>
Subject: [PATCH] wifi: mt76: add bounded HG5585F RX/PPE debug switch

Add a disabled runtime debug switch for temporary hardware validation. Level
1 logs raw legacy RX descriptors, level 2 logs the RX-to-PPE handoff, and
level 3 enables both. Kernel rate limiting prevents traffic from flooding the
log. The switch does not change ownership, force-to-CPU mode, or forwarding.

---
--- a/mt76.h
+++ b/mt76.h
@@ -1743,6 +1743,12 @@
 }
 
 #ifdef CONFIG_MT76_NPU
+#ifdef CONFIG_MT76_NPU_LEGACY
+unsigned int mt76_npu_legacy_debug_level(void);
+#else
+static inline unsigned int mt76_npu_legacy_debug_level(void) { return 0; }
+#endif
+
 void mt76_npu_check_ppe(struct mt76_dev *dev, struct sk_buff *skb,
 			u32 info);
 int mt76_npu_dma_add_buf(struct mt76_phy *phy, struct mt76_queue *q,
--- a/npu.c
+++ b/npu.c
@@ -130,6 +130,14 @@
 {
 	struct airoha_ppe_dev *ppe_dev;
 	u16 reason, hash;
+
+	if (mt76_npu_legacy_debug_level() & 2)
+		dev_info_ratelimited(dev->dev,
+			"hg5585f-rx-ppe dev=%s len=%u info=%08x hash=%u crsn=%u active=%u\n",
+			skb->dev ? skb->dev->name : "?", skb->len, info,
+			(unsigned int)FIELD_GET(NPU_RX_DMA_FOE_ID_MASK, info),
+			(unsigned int)FIELD_GET(NPU_RX_DMA_CRSN_MASK, info),
+			(unsigned int)mt76_npu_device_active(dev));
 
 	if (!mt76_npu_device_active(dev))
 		return;
--- a/npu_rx_legacy.c
+++ b/npu_rx_legacy.c
@@ -1,10 +1,43 @@
 // SPDX-License-Identifier: GPL-2.0-only
 /* HG5585F host RX queues. The caller must quiesce DMA before cleanup. */
 #include <linux/soc/airoha/airoha_wlan_legacy.h>
+#include <linux/module.h>
 
 #include "mt76.h"
 #include "dma.h"
 
+static unsigned int legacy_rx_debug;
+module_param_named(legacy_rx_debug, legacy_rx_debug, uint, 0644);
+MODULE_PARM_DESC(legacy_rx_debug,
+                 "HG5585F RX debug level: 1=descriptor, 2=PPE, 3=both");
+
+unsigned int mt76_npu_legacy_debug_level(void)
+{
+        return READ_ONCE(legacy_rx_debug);
+}
+
+static void mt76_npu_legacy_rx_debug_dump(struct mt76_dev *dev,
+                                          struct mt76_queue *q,
+                                          const struct airoha_wlan_legacy_rx_meta *meta,
+                                          unsigned int count)
+{
+        struct airoha_wlan_legacy_rx_desc *desc = (void *)q->desc;
+        unsigned int i, slot = q->tail;
+
+        for (i = 0; i < count; i++, slot = (slot + 1) % q->ndesc)
+                dev_info_ratelimited(dev->dev,
+                         "hg5585f-rx-desc q=%u slot=%u ctrl=%08x info=%08x data=%08x dma=%08x len=%u total=%u frag=%u frags=%u last=%u meta_info=%08x meta_data=%08x\n",
+                         (unsigned int)(q - dev->q_rx), slot,
+                         le32_to_cpu(READ_ONCE(desc[slot].ctrl)),
+                         le32_to_cpu(READ_ONCE(desc[slot].info)),
+                         le32_to_cpu(READ_ONCE(desc[slot].data)),
+                         le32_to_cpu(READ_ONCE(desc[slot].dma_addr)),
+                         (unsigned int)meta[i].length, (unsigned int)meta[i].total,
+                         (unsigned int)meta[i].fragment,
+                         (unsigned int)meta[i].fragments, (unsigned int)meta[i].last,
+                         meta[i].info, meta[i].data);
+}
+
 int mt76_npu_legacy_rx_fill(struct mt76_dev *dev, struct mt76_queue *q)
 {
 	struct airoha_wlan_legacy_rx_desc *desc = (void *)q->desc;
@@ -209,6 +242,8 @@
 
 	/* Copy into one linear skb; no partial page ownership passes to mac80211. */
 	skb = napi_alloc_skb(&dev->napi[q - dev->q_rx], meta[0].total);
+	if (mt76_npu_legacy_debug_level() & 1)
+		mt76_npu_legacy_rx_debug_dump(dev, q, meta, count);
 	mt76_npu_legacy_rx_retire(dev, q, count, skb, meta);
 	if (!skb)
 		return ERR_PTR(-ENOMEM);
