#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only

# rc.common consumes these two globals.
# shellcheck disable=SC2034
START=98
# shellcheck disable=SC2034
USE_PROCD=1

start_service() {
	local enabled expect wait interval samples require_traffic

	config_load hg5585f-offload-check
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || return 0
	config_get expect main expect auto
	config_get wait main wait 60
	config_get interval main interval 3
	config_get samples main samples 2
	config_get_bool require_traffic main require_traffic 0

	procd_open_instance
	procd_set_param command /usr/sbin/hg5585f-offload-check \
		--expect "$expect" --wait "$wait" --interval "$interval" --samples "$samples"
	[ "$require_traffic" = 1 ] && procd_append_param command --require-traffic
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
