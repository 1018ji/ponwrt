@@ -564,6 +615,10 @@
 	u32 val = 0;
 	int err;
 
+	/* The stock blob needs its own RX buffer ownership implementation. */
+	if (npu->wlan_abi == AIROHA_NPU_WLAN_ABI_HG5585F_2024)
+		return -EOPNOTSUPP;
+
 	err = airoha_npu_wlan_msg_send(npu, 1, cmd, &val, sizeof(val),
 				       GFP_KERNEL);
 	if (err)
@@ -722,7 +777,43 @@
 	.reg_stride		= 4,
 	.disable_locking	= true,
 };
+
+static int airoha_npu_wlan_select_abi(struct airoha_npu *npu)
+{
+	struct device *dev = npu->dev;
+	const char *firmware[2];
+	const char *abi;
+	int err;
+
+	if (!of_property_present(dev->of_node, "airoha,wlan-firmware-abi"))
+		return 0;
+
+	err = of_property_read_string(dev->of_node, "airoha,wlan-firmware-abi", &abi);
+	if (err)
+		return err;
+	if (strcmp(abi, "hg5585f-2024"))
+		return dev_err_probe(dev, -EINVAL, "unknown WLAN firmware ABI: %s\n", abi);
+	if (!IS_ENABLED(CONFIG_NET_AIROHA_NPU_HG5585F))
+		return dev_err_probe(dev, -EOPNOTSUPP,
+				     "HG5585F WLAN protocol is not configured\n");
+	if (!of_device_is_compatible(dev->of_node, "airoha,en7581-npu"))
+		return dev_err_probe(dev, -EINVAL, "HG5585F ABI requires EN7581\n");
+	if (of_property_count_strings(dev->of_node, "firmware-name") != 2)
+		return dev_err_probe(dev, -EINVAL,
+				     "HG5585F ABI requires an explicit firmware pair\n");
+	err = of_property_read_string_array(dev->of_node, "firmware-name",
+					    firmware, ARRAY_SIZE(firmware));
+	if (err != ARRAY_SIZE(firmware))
+		return -EINVAL;
+	if (strcmp(firmware[0], "airoha/hg5585f_npu_rv32.bin") ||
+	    strcmp(firmware[1], "airoha/hg5585f_npu_data.bin"))
+		return dev_err_probe(dev, -EINVAL, "HG5585F firmware pair mismatch\n");
 
+	npu->wlan_abi = AIROHA_NPU_WLAN_ABI_HG5585F_2024;
+	dev_info(dev, "HG5585F WLAN protocol diagnostics; upstream PPE disabled\n");
+	return 0;
+}
+
 static int airoha_npu_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
@@ -741,6 +832,9 @@
 		return -ENOMEM;
 
 	npu->dev = dev;
+	err = airoha_npu_wlan_select_abi(npu);
+	if (err)
+		return err;
 	npu->ops.ppe_init = airoha_npu_ppe_init;
 	npu->ops.ppe_deinit = airoha_npu_ppe_deinit;
 	npu->ops.ppe_init_stats = airoha_npu_ppe_stats_setup;
@@ -809,7 +903,10 @@
 	for (i = 0; i < ARRAY_SIZE(npu->cores); i++) {
 		struct airoha_npu_core *core = &npu->cores[i];
 
-		core->buf = dmam_alloc_coherent(dev, AIROHA_NPU_MBOX_SIZE,
+		unsigned int capacity = npu->wlan_abi == AIROHA_NPU_WLAN_ABI_HG5585F_2024
+			? AIROHA_WLAN_LEGACY_MBOX_SIZE : AIROHA_NPU_MBOX_SIZE;
+
+		core->buf = dmam_alloc_coherent(dev, capacity,
 						&core->addr, GFP_KERNEL);
 		if (!core->buf)
 			return -ENOMEM;
@@ -836,7 +933,8 @@
 	regmap_write(npu->regmap, REG_CR_BOOT_TRIGGER, 0x1);
 	msleep(100);
 
-	if (!airoha_npu_wlan_msg_get(npu, 0, WLAN_FUNC_GET_WAIT_NPU_VERSION,
+	if (npu->wlan_abi == AIROHA_NPU_WLAN_ABI_UPSTREAM &&
+	    !airoha_npu_wlan_msg_get(npu, 0, WLAN_FUNC_GET_WAIT_NPU_VERSION,
 				     &val, sizeof(val), GFP_KERNEL))
 		dev_info(dev, "NPU fw version: %0d.%d\n",
 			 (val >> 16) & 0xffff, val & 0xffff);
--- a/include/linux/soc/airoha/airoha_offload.h
+++ b/include/linux/soc/airoha/airoha_offload.h
@@ -163,10 +163,16 @@
 	WLAN_FUNC_GET_WAIT_NPU_VERSION,
 };
 
+enum airoha_npu_wlan_abi {
