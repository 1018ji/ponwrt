 	if (!wlan_data)
 		return -ENOMEM;
 
 	wlan_data->ifindex = ifindex;
 	wlan_data->func_type = NPU_OP_SET;
-	wlan_data->func_id = func_id;
-	memcpy(wlan_data->d, data, data_len);
+	wlan_data->func_id = wire_id;
+	if (data_len)
+		memcpy(wlan_data->d, data, data_len);
 
 	err = airoha_npu_send_msg(npu, NPU_FUNC_WIFI, wlan_data, len);
 	kfree(wlan_data);
@@ -520,19 +559,31 @@
 				   void *data, int data_len, gfp_t gfp)
 {
 	struct wlan_mbox_data *wlan_data;
-	int err, len;
+	int err, len, wire_id = func_id;
+
+	if (ifindex < 0 || ifindex > 15 || data_len <= 0 || !data ||
+	    data_len > AIROHA_NPU_MBOX_SIZE - sizeof(*wlan_data))
+		return -EINVAL;
 
+	if (npu->wlan_abi == AIROHA_NPU_WLAN_ABI_HG5585F_2024) {
+		wire_id = airoha_wlan_legacy_get_id(func_id);
+		if (wire_id < 0)
+			return wire_id;
+	}
+
 	len = sizeof(*wlan_data) + data_len;
+	if (npu->wlan_abi == AIROHA_NPU_WLAN_ABI_HG5585F_2024)
+		len = AIROHA_WLAN_LEGACY_MBOX_SIZE;
 	wlan_data = kzalloc(len, gfp);
 	if (!wlan_data)
 		return -ENOMEM;
 
 	wlan_data->ifindex = ifindex;
 	wlan_data->func_type = NPU_OP_GET;
-	wlan_data->func_id = func_id;
+	wlan_data->func_id = wire_id;
 
 	err = __airoha_npu_send_msg(npu, NPU_FUNC_WIFI, wlan_data, len,
-				    data, data_len);
+				    data, sizeof(*wlan_data), data_len);
 	kfree(wlan_data);
 
