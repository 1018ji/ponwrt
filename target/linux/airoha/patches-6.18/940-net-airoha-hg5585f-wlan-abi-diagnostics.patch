--- /dev/null
+++ b/include/linux/soc/airoha/airoha_wlan_legacy.h
@@ -0,0 +1,145 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* HG5585F 2024 NPU WLAN ABI, recovered from the stock ARM64 modules. */
+#ifndef __AIROHA_WLAN_LEGACY_H
+#define __AIROHA_WLAN_LEGACY_H
+
+#include <linux/bitfield.h>
+#include <linux/build_bug.h>
+#include <linux/errno.h>
+#include <linux/stddef.h>
+#include <linux/types.h>
+#include <linux/soc/airoha/airoha_offload.h>
+
+#define AIROHA_WLAN_LEGACY_MBOX_SIZE	0x1140
+#define AIROHA_WLAN_MBOX_HEADER_SIZE	8
+#define AIROHA_WLAN_LEGACY_RX_DESC_BYTES	24
+#define AIROHA_WLAN_LEGACY_RX_DESC_COUNT	256
+#define AIROHA_WLAN_LEGACY_RX_BUF_BYTES	1725
+#define AIROHA_WLAN_LEGACY_RX_MAX_FRAGS	7
+
+/* Reject unverified commands instead of aliasing the newer enum wholesale. */
+static inline int airoha_wlan_legacy_set_id(enum airoha_npu_wlan_set_cmd cmd)
+{
+	switch (cmd) {
+	case WLAN_FUNC_SET_WAIT_PCIE_ADDR:
+	case WLAN_FUNC_SET_WAIT_DESC:
+	case WLAN_FUNC_SET_WAIT_TRAN_TO_CPU:
+	case WLAN_FUNC_SET_WAIT_BA_WIN_SIZE:
+	case WLAN_FUNC_SET_WAIT_DRIVER_MODEL:
+	case WLAN_FUNC_SET_WAIT_DRAM_BA_NODE_ADDR:
+	case WLAN_FUNC_SET_WAIT_PKT_BUF_ADDR:
+	case WLAN_FUNC_SET_WAIT_IS_TEST_NOBA:
+	case WLAN_FUNC_SET_WAIT_FLUSHONE_TIMEOUT:
+	case WLAN_FUNC_SET_WAIT_FLUSHALL_TIMEOUT:
+	case WLAN_FUNC_SET_WAIT_IS_FORCE_TO_CPU:
+		return cmd;
+	case WLAN_FUNC_SET_WAIT_PCIE_PORT_TYPE:
+		return 15;
+	case WLAN_FUNC_SET_WAIT_ERROR_RETRY_TIMES:
+		return 16;
+	case WLAN_FUNC_SET_WAIT_FAST_FLAG:
+		return 28;
+	default:
+		return -EOPNOTSUPP;
+	}
+}
+
+static inline int airoha_wlan_legacy_get_id(enum airoha_npu_wlan_get_cmd cmd)
+{
+	switch (cmd) {
+	case WLAN_FUNC_GET_WAIT_COUNTER:
+	case WLAN_FUNC_GET_WAIT_DBG_COUNTER:
+	case WLAN_FUNC_GET_WAIT_RXDESC_BASE:
+		return cmd;
+	default:
+		return -EOPNOTSUPP;
+	}
+}
+
+#define AIROHA_WLAN_LEGACY_RX_DONE	BIT(0)
+#define AIROHA_WLAN_LEGACY_RX_LENGTH	GENMASK(13, 1)
+#define AIROHA_WLAN_LEGACY_RX_TOTAL	GENMASK(26, 14)
+#define AIROHA_WLAN_LEGACY_RX_LAST	BIT(27)
+#define AIROHA_WLAN_LEGACY_RX_FRAG_ID	GENMASK(28, 26)
+#define AIROHA_WLAN_LEGACY_RX_FRAG_COUNT	GENMASK(31, 29)
+
+struct airoha_wlan_legacy_rx_desc {
+	__le32 ctrl;
+	__le32 info;
+	__le32 data;
+	__le32 dma_addr;
+	/* Opaque host cookie. Never interpret it as a firmware address. */
+	__le64 software_cookie;
+} __packed;
+
+static_assert(sizeof(struct airoha_wlan_legacy_rx_desc) ==
+	      AIROHA_WLAN_LEGACY_RX_DESC_BYTES);
+static_assert(offsetof(struct airoha_wlan_legacy_rx_desc, dma_addr) == 12);
+static_assert(offsetof(struct airoha_wlan_legacy_rx_desc, software_cookie) == 16);
+
+struct airoha_wlan_legacy_rx_meta {
+	u16 length;
+	u16 total;
+	u8 fragment;
+	u8 fragments;
+	u8 last;
+	u32 info;
+	u32 data;
+};
+
+/* Decode only. The caller still owns the DMA buffer and descriptor. */
+static inline int
+airoha_wlan_legacy_rx_decode(u32 ctrl, u32 info, u32 data, u32 capacity,
+			     struct airoha_wlan_legacy_rx_meta *meta)
+{
+	u16 length, total;
+
+	if (!(ctrl & AIROHA_WLAN_LEGACY_RX_DONE))
+		return -EAGAIN;
+
+	length = FIELD_GET(AIROHA_WLAN_LEGACY_RX_LENGTH, ctrl);
+	total = FIELD_GET(AIROHA_WLAN_LEGACY_RX_TOTAL, ctrl);
+	if (!length || length > capacity || total < length)
+		return -EBADMSG;
+
+	*meta = (struct airoha_wlan_legacy_rx_meta) {
+		.length = length,
+		.total = total,
+		.fragment = FIELD_GET(AIROHA_WLAN_LEGACY_RX_FRAG_ID, info),
+		.fragments = FIELD_GET(AIROHA_WLAN_LEGACY_RX_FRAG_COUNT, info),
+		.last = !!(ctrl & AIROHA_WLAN_LEGACY_RX_LAST),
+		.info = info,
+		.data = data,
+	};
+	if (!meta->fragments)
+		meta->fragments = 1;
+
+	return 0;
+}
+
+/* Validate a completed packet before touching any of its DMA buffers. */
+static inline int
+airoha_wlan_legacy_rx_chain(const struct airoha_wlan_legacy_rx_meta *meta,
+			    unsigned int count)
+{
+	unsigned int i, length = 0;
+
+	if (!count || count > AIROHA_WLAN_LEGACY_RX_MAX_FRAGS ||
+	    meta[0].fragments != count)
+		return -EBADMSG;
+
+	for (i = 0; i < count; i++) {
+		if (!meta[i].length || meta[i].total != meta[0].total ||
+		    meta[i].fragments != count)
+			return -EBADMSG;
+		/* Stock fragment IDs are one-based; standalone packets can use 0. */
+		if (count > 1 &&
+		    (meta[i].fragment != i + 1 || meta[i].last != (i == count - 1)))
+			return -EBADMSG;
+		length += meta[i].length;
+	}
+
+	return length == meta[0].total ? 0 : -EBADMSG;
+}
+
+#endif
