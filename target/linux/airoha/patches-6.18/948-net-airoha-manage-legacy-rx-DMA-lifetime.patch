+static int airoha_npu_boot(struct airoha_npu *npu, void __iomem *base,
+			   struct resource *region)
+{
+	struct airoha_npu_legacy *legacy = npu->legacy;
+	int i, err;
+
+	if (legacy) {
+		lockdep_assert_held(&legacy->lock);
+		legacy->state = LEGACY_RUNNING;
+		err = reset_control_deassert(legacy->gdma_reset);
+		if (err)
+			return err;
+		/* Discard the verified RX copy channel's state before NPU boot. */
+		for (i = 0; i < 4; i++)
+			writel(0, legacy->gdma + (LEGACY_RX_COPY_CHANNEL << 4) + i * 4);
+		readl(legacy->gdma + LEGACY_GDMA_CTRL0(LEGACY_RX_COPY_CHANNEL));
+		err = reset_control_deassert(legacy->npu_reset);
+		if (err)
+			return err;
+		for (i = 0; i < 2; i++) {
+			regmap_write(npu->regmap, REG_RX_BASE(i), 0);
+			regmap_write(npu->regmap, REG_RX_DSCP_NUM(i), 0);
+			regmap_write(npu->regmap, REG_RX_CPU_IDX(i), 0);
+			regmap_write(npu->regmap, REG_RX_DMA_IDX(i), 0);
+		}
+	}
+	err = airoha_npu_run_firmware(npu, base, region);
+	if (err)
+		return err;
+
+	regmap_write(npu->regmap, REG_CR_NPU_MIB(10),
+		     region->start + NPU_EN7581_FIRMWARE_RV32_MAX_SIZE);
+	regmap_write(npu->regmap, REG_CR_NPU_MIB(11), 0x40000);
+	regmap_write(npu->regmap, REG_CR_NPU_MIB(12), 0);
+	regmap_write(npu->regmap, REG_CR_NPU_MIB(21), 1);
+	msleep(100);
+	for (i = 0; i < NPU_NUM_CORES; i++)
+		regmap_write(npu->regmap, REG_CR_BOOT_BASE(i), region->start);
+	usleep_range(1000, 2000);
+	regmap_write(npu->regmap, REG_CR_BOOT_CONFIG, 0xff);
+	regmap_write(npu->regmap, REG_CR_BOOT_TRIGGER, 0x1);
+	msleep(100);
+	if (legacy) {
+		spin_lock_bh(&npu->cores[0].lock);
+		npu->cores[0].legacy_timeout = false;
+		WRITE_ONCE(legacy->blocked, false);
+		spin_unlock_bh(&npu->cores[0].lock);
+	}
+
 	return 0;
 }
 
