+static int airoha_npu_legacy_init_memory(struct airoha_npu *npu)
+{
+	struct resource pkt, ba;
+	void __iomem *area;
+	__le32 value;
+	int index, err;
+
+	index = of_property_match_string(npu->dev->of_node, "memory-region-names", "pkt");
+	if (index < 0)
+		return index;
+	err = of_reserved_mem_region_to_resource(npu->dev->of_node, index, &pkt);
+	if (err)
+		return err;
+	index = of_property_match_string(npu->dev->of_node, "memory-region-names", "ba");
+	if (index < 0)
+		return index;
+	err = of_reserved_mem_region_to_resource(npu->dev->of_node, index, &ba);
+	if (err)
+		return err;
+	err = airoha_wlan_legacy_memory_valid(pkt.start, resource_size(&pkt),
+					      ba.start, resource_size(&ba));
+	if (err)
+		return err;
+	if (resource_overlaps(&pkt, &npu->legacy->region) ||
+	    resource_overlaps(&ba, &npu->legacy->region))
+		return -EINVAL;
+	if (!npu->legacy->ba) {
+		area = devm_ioremap_resource(npu->dev, &ba);
+		if (IS_ERR(area))
+			return PTR_ERR(area);
+		npu->legacy->ba = area;
+	}
+	memset_io(npu->legacy->ba, 0, AIROHA_WLAN_LEGACY_BA_BYTES);
+	/* Reorder nodes must be visible before their address reaches firmware. */
+	wmb();
+	value = cpu_to_le32(pkt.start);
+	err = airoha_npu_wlan_msg_send(npu, 0, WLAN_FUNC_SET_WAIT_PKT_BUF_ADDR,
+				       &value, sizeof(value), GFP_KERNEL);
+	if (err)
+		return err;
+	value = cpu_to_le32(ba.start);
+	return airoha_npu_wlan_msg_send(npu, 0, WLAN_FUNC_SET_WAIT_DRAM_BA_NODE_ADDR,
+				       &value, sizeof(value), GFP_KERNEL);
+}
