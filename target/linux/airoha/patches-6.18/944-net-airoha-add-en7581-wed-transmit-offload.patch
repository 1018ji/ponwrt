+
+static int airoha_ppe_wed_invalidate(struct airoha_ppe *ppe,
+				     struct airoha_flow_table_entry *e)
+{
+	struct airoha_foe_entry invalid;
+	int err;
+
+	e->disabled = true;
+	if (e->hash == 0xffff)
+		return 0;
+	memcpy(&invalid, &e->data, sizeof(invalid));
+	invalid.ib1 &= ~AIROHA_FOE_IB1_BIND_STATE;
+	err = airoha_ppe_foe_commit_entry(ppe, &invalid, e->hash, false);
+	if (!err)
+		e->hash = 0xffff;
+
+	return err;
+}
+
+static int airoha_ppe_flush_wed(struct airoha_ppe_dev *dev, u16 wcid)
+{
+	struct airoha_ppe *ppe = dev->priv;
+	struct airoha_flow_table_entry *e;
+	struct rhashtable_iter iter;
+	int err = 0;
+
+	mutex_lock(&flow_offload_mutex);
+	rhashtable_walk_enter(&ppe->eth->flow_table, &iter);
+	rhashtable_walk_start(&iter);
+	while ((e = rhashtable_walk_next(&iter))) {
+		if (IS_ERR(e)) {
+			if (PTR_ERR(e) == -EAGAIN)
+				continue;
+			err = PTR_ERR(e);
+			break;
+		}
+		spin_lock_bh(&ppe_lock);
+		if (!e->wed || (wcid != U16_MAX && e->wed_sta_id != wcid))
+			goto next;
+		e->disabled = true;
+		if (e->type == FLOW_TYPE_L2) {
+			struct airoha_flow_table_entry *sub;
+
+			hlist_for_each_entry(sub, &e->l2_flows, l2_subflow_node) {
+				err = airoha_ppe_wed_invalidate(ppe, sub);
+				if (err)
+					break;
+			}
+		} else {
+			err = airoha_ppe_wed_invalidate(ppe, e);
+		}
+next:
+		spin_unlock_bh(&ppe_lock);
+		if (err)
+			break;
+	}
+	rhashtable_walk_stop(&iter);
+	rhashtable_walk_exit(&iter);
+	mutex_unlock(&flow_offload_mutex);
+
+	return err;
 }
 
