+
+static int airoha_ppe_wed_egress(const struct airoha_wdma_info *info,
+				 u32 *ib2, u32 *data)
+{
+	u8 nbq;
+
+	if (!IS_ENABLED(CONFIG_NET_AIROHA_WED) || info->idx != 1 ||
+	    info->queue > 1 || info->wcid != 0x3ff || info->bss > 63)
+		return -EOPNOTSUPP;
+	nbq = info->idx * 2 + info->queue;
+	*ib2 |= FIELD_PREP(AIROHA_FOE_IB2_NBQ, nbq) |
+		FIELD_PREP(AIROHA_FOE_IB2_PSE_PORT, FE_PSE_PORT_GDM3) |
+		AIROHA_FOE_IB2_PSE_QOS;
+	*data |= FIELD_PREP(AIROHA_FOE_CHANNEL, nbq + 6);
+
+	/* Ordinary AP frames request firmware destination lookup, not WDS. */
+	return (0xff << 6) | info->bss;
 }
 
