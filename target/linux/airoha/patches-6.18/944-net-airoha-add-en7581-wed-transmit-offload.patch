From: PonWrt developers <noreply@localhost>
Subject: [PATCH] net: airoha: add opt-in EN7581 WED transmit offload

Provide the HG5585F WED1/WDMA1 transmit transport for MT7916 while keeping
upstream NPU firmware for PPE and native wireless receive. Route WED flows
through PSE port 3 with an explicit path type, queue and firmware
destination lookup encoding.

Reserve hardware tokens before publishing DMA buffers, acknowledge reset
completion before releasing DMA memory and quarantine failed stops. Flush
station flows using software station IDs and disable cached templates
before WCID reuse. Keep NPU
wireless egress and WED transport metadata separate.

---
--- a/drivers/net/ethernet/airoha/Kconfig
+++ b/drivers/net/ethernet/airoha/Kconfig
@@ -47,6 +47,18 @@
 	  This driver supports the gigabit ethernet MACs in the
 	  Airoha SoC family.
 
+config NET_AIROHA_WED
+	bool "EN7581 MT7916 WED transmit offload (experimental)"
+	depends on ARCH_AIROHA && NET_AIROHA=y && OF && PCI && EXPERT
+	select NET_VENDOR_MEDIATEK
+	select NET_MEDIATEK_SOC_WED
+	default n
+	help
+	  Enable the HG5585F WED1/WDMA1 transmit provider for MT7916D.
+	  Requires an explicit WED device-tree overlay and mt7915e.wed_enable=1.
+	  Retains the upstream NPU firmware for PPE and software Wi-Fi RX.
+	  This provider does not support NPU receive offloading.
+
 config NET_AIROHA_FLOW_STATS
 	default y
 	bool "Airoha flow stats"
